<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cucook.moc.place.dao.PlaceDAO">

    <resultMap id="PlaceResultMap" type="com.cucook.moc.place.vo.PlaceVO">
        <id     property="placeId"          column="place_id"/>
        <result property="mapProviderCd"    column="map_provider_cd"/>
        <result property="placeExternalId"  column="place_external_id"/>
        <result property="placeName"        column="place_name"/>
        <result property="address"          column="address"/>
        <result property="latitude"         column="latitude"/>
        <result property="longitude"        column="longitude"/>
        <result property="createdId"        column="created_id"/>
        <result property="createdDate"      column="created_date"/>
        <result property="updatedId"        column="updated_id"/>
        <result property="updatedDate"      column="updated_date"/>
    </resultMap>

    <!-- 외부 place id로 조회 -->
    <select id="selectByExternalId"
            resultMap="PlaceResultMap">
        SELECT *
        FROM tb_place
        WHERE map_provider_cd   = #{mapProviderCd, jdbcType=VARCHAR}
          AND place_external_id = #{placeExternalId, jdbcType=VARCHAR}
    </select>

    <!-- 장소 insert (upsert 시 insert용) -->
    <insert id="insertPlace"
            parameterType="PlaceVO">
        <selectKey keyProperty="placeId"
                   resultType="long"
                   order="BEFORE">
            SELECT seq_tb_place.NEXTVAL FROM dual
        </selectKey>

        INSERT INTO tb_place (
            place_id,
            map_provider_cd,
            place_external_id,
            place_name,
            address,
            latitude,
            longitude,
            created_id,
            created_date
        ) VALUES (
            #{placeId, jdbcType=VARCHAR},
            #{mapProviderCd, jdbcType=VARCHAR},
            #{placeExternalId, jdbcType=VARCHAR},
            #{placeName, jdbcType=VARCHAR},
            #{address, jdbcType=VARCHAR},
            #{latitude, jdbcType=NUMERIC},
            #{longitude, jdbcType=NUMERIC},
            #{createdId, jdbcType=NUMERIC},
            SYSTIMESTAMP
        )
    </insert>
</mapper>
